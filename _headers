/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://api.hyperliquid.xyz https://cloudflareinsights.com; object-src 'none'; frame-ancestors 'self'; base-uri 'self'; form-action 'none'; upgrade-insecure-requests

# 图标文件名固定但内容基本不变：可长缓存，但保留回源核对的能力
# （不使用 immutable —— 那会让浏览器在有效期内完全拒绝重新校验）
/icon-192.png
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

/icon-512.png
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

/apple-touch-icon.png
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

/favicon.ico
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

# 分享卡片会随站点改版重绘，且各社交平台会各自抓取缓存，必须短缓存
/og.png
  Cache-Control: public, max-age=3600, must-revalidate

/site.webmanifest
  Cache-Control: public, max-age=86400
