/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://api.hyperliquid.xyz https://cloudflareinsights.com; object-src 'none'; frame-ancestors 'self'; base-uri 'self'; form-action 'none'; upgrade-insecure-requests

# 图标：此前设 30 天缓存，导致换了图标之后老访客一个月都看不到新的。
# 品牌资产会改，就不该按「基本不变」来设缓存。改为 1 小时 + 后台再校验：
# 浏览器仍能立即用本地副本（无感知），但同时回源确认，下次访问即更新。
/icon-192.png
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/icon-512.png
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/apple-touch-icon.png
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/favicon.ico
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

# 分享卡片会随站点改版重绘，且各社交平台会各自抓取缓存，必须短缓存
/og.png
  Cache-Control: public, max-age=3600, must-revalidate

/site.webmanifest
  Cache-Control: public, max-age=86400
